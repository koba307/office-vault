# Telegram
BOT_TOKEN=your_telegram_bot_token_here
SUPERADMIN_TELEGRAM_ID=123456789

# Database
POSTGRES_USER=officevault
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=officevault
DATABASE_URL=postgresql+asyncpg://officevault:change_me_strong_password@postgres:5432/officevault

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=office-vault
MINIO_SECURE=false

# Encryption
MASTER_ENCRYPTION_KEY=generate_with_python_secrets_token_hex_32

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# ClamAV (optional, for file scanning)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
